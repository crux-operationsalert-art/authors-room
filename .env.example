# Copy to .env (never commit). Server-side values must never reach the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # worker + /api/keys only
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DAILY_COST_CAP_USD=5
GEMINI_PROJECT_LABEL=Author's Room
GEMINI_PROJECT_REF=                   # project name shown in Google AI Studio
GEMINI_USAGE_TIER=free                # free | tier1 | tier2 | tier3
# Gemini keys are NOT set here. Load them with `npm run load-keys` (stdin) or the /keys page.
